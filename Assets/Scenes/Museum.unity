  m_Script: {fileID: 11500000, guid: a7df911688ca425f8f129e9c77e6df6e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Readable
  Title: Exhibit VI - The Morvayne Register
  Body: 'The family''s own record of its dead, open at the last page.


    Cassius
    Morvayne. Interred.

    Aurelian Morvayne. Interred.

    Isolde Morvayne. Interred.


    Elias
    Morvayne. The name is struck through in red ink, and beside it, in the same hand:

    "Traitor
    to the blood. He kept company with hunters. No Morvayne shall visit him."'
  ReadClip: {fileID: 8300000, guid: d827ef23d1b788f4b92b1131a21aa803, type: 3}
  Verb: Read
