  m_Script: {fileID: 11500000, guid: a7df911688ca425f8f129e9c77e6df6e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Readable
  Title: Exhibit II - Countess Ilse Morvayne
  Body: 'Oil on canvas. Painted in 1702 by Matthias Kell, and again by the same hand
    in 1781.


    Kell was nineteen at the first sitting and ninety-eight at the
    second. The Countess does not appear to have aged between them.


    The artist''s
    remains were never found.'
  ReadClip: {fileID: 8300000, guid: d827ef23d1b788f4b92b1131a21aa803, type: 3}
  Verb: Read
